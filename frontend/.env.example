# =============================================
# Frontend (Nuxt) Environment Variables
# =============================================
# Copy this file to .env and fill in your values
#
# Note: Variables prefixed with NUXT_PUBLIC_ are exposed to the client
# Never put secrets in NUXT_PUBLIC_ variables!

# Backend URL (server-side only - not exposed to client)
# Used by Nuxt server routes to call the Spring Boot backend
# Microservices URLs (server-side only)
FUNDING_SERVICE_URL=http://localhost:8081
ARBITRAGE_SERVICE_URL=http://localhost:8082
AUTH_SERVICE_URL=http://localhost:8083
# BACKEND_URL=http://localhost:8080 (Legacy)

# WalletConnect Project ID
# Get yours at https://cloud.walletconnect.com
# This is public and safe to expose (it's just an identifier)
NUXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# API Base Path (optional, defaults to /api)
# NUXT_PUBLIC_API_BASE=/api
