# =============================================
# Backend Environment Variables
# =============================================
# Copy this file to .env and fill in your values

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cryptodb
DB_USERNAME=cryptouser
DB_PASSWORD=cryptopass

# App Security
# Change this to a random 32+ character string in production!
ENCRYPTION_KEY=MySuperSecretKeyChangeMe123

# First Admin Wallet Address
# This wallet will be created as ADMIN with PRO plan on first backend startup
# Replace with your own wallet address!
APP_ADMIN_WALLET=0xYourWalletAddressHere

# Mistral AI API Key (for chat feature)
# Get yours at https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here
