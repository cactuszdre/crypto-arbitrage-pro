# =============================================
# Fichier .env pour la production sur le Droplet
# Copier ce fichier en .env.prod et remplir les valeurs
# NE JAMAIS COMMITTER .env.prod dans Git !
# =============================================

# Base de données PostgreSQL
DB_NAME=cryptodb
DB_USERNAME=cryptouser
DB_PASSWORD=CHANGE_MOI_MOT_DE_PASSE_FORT

# Sécurité (minimum 32 caractères chacun)
ENCRYPTION_KEY=CHANGE_MOI_CLE_32_CHARS_MINIMUM_ICI
JWT_SECRET=CHANGE_MOI_CLE_64_CHARS_MINIMUM_POUR_JWT_ICI

# Wallet admin
APP_ADMIN_WALLET=0xTON_ADRESSE_WALLET

# Frontend
NUXT_PUBLIC_WALLETCONNECT_PROJECT_ID=TON_PROJECT_ID_WALLETCONNECT
NUXT_PUBLIC_API_BASE=/api

# Mistral AI (optionnel)
MISTRAL_API_KEY=TA_CLE_MISTRAL_API
